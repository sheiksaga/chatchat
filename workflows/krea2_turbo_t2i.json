{
  "1": {
    "inputs": {
      "unet_name": "{{MODEL}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Krea2 Diffusion Model" }
  },
  "2": {
    "inputs": {
      "model": ["1", 0],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}"
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Krea2 Model LoRA 1 (strength 0 = off)" }
  },
  "3": {
    "inputs": {
      "model": ["2", 0],
      "lora_name": "{{UNLOCKED_LORA_NAME}}",
      "strength_model": "{{UNLOCKED_LORA_STRENGTH}}"
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Krea2 Model LoRA 2 (strength 0 = off)" }
  },
  "4": {
    "inputs": {
      "clip_name": "{{CLIP}}",
      "type": "{{CLIP_TYPE}}",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Qwen3-VL text encoder (type krea2)" }
  },
  "5": {
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": ["4", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "6": {
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Latent Canvas" }
  },
  "7": {
    "inputs": {
      "conditioning": ["5", 0]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative = zeroed positive (CFG 1.0)" }
  },
  "8": {
    "inputs": {
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["5", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (CFG 1.0, euler/simple)" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["11", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "10": {
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  },
  "11": {
    "inputs": {
      "vae_name": "{{VAE}}"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" }
  }
}
