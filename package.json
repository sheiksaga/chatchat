{
	"name": "chatchat",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "npm run check && npm run lint && npm run test",
		"import:legacy": "tsx tools/import-legacy.ts",
		"doctor": "tsx tools/doctor.ts",
		"dev:fake": "tsx tools/fake-llm.ts",
		"import:cards": "tsx tools/import-cards.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"release:zip": "tar -a -c -f dist/chatchat.zip --exclude data --exclude legacy --exclude node_modules --exclude dist --exclude _notes --exclude .git --exclude .svelte-kit --exclude .e2e-data --exclude test-results ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "6.4.5",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.79",
		"@ai-sdk/svelte": "^5.0.154",
		"@lenml/char-card-reader": "^1.1.1",
		"@stable-canvas/comfyui-client": "^1.5.9",
		"ai": "^7.0.154",
		"clsx": "^2.1.1",
		"svelte-streamdown": "^5.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	}
}
