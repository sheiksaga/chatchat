# OS / editor junk
.DS_Store
Thumbs.db
*.rtf
*.log
.vscode/
.idea/

# local agent + tooling config
.claude/
.superpowers/
.sessions/
docs/
"error images/"

# dev dependencies — prettier only, never loaded by the app itself.
# package.json and package-lock.json ARE tracked; node_modules is not.
node_modules/

# local generator output (scratch screenshots from manual checks)
screenshots/

# local imagegen server — machine-specific (this PC's GPU/model setup), not part of the app
local-image-server/

# Synced character-card art — regenerated by `npm run sync-cards`, and
# machine-specific (it is a copy of one person's SillyTavern library).
# cards/cards.js itself stays tracked so the app loads before any sync.
cards/avatars/
